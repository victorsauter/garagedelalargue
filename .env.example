# Local SQLite (Prisma). For production on Vercel, use a Neon Postgres URL:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DATABASE_URL="file:./dev.db"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"

# Public site URL (used in Facebook posts, emails, sitemap)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional: Vercel Blob for production image uploads.
# If unset, photos are stored under public/uploads (local filesystem).
BLOB_READ_WRITE_TOKEN=""

# Optional: Resend for inquiry / RDV emails to accueil@garagedelalargue.com
# If unset, inquiries are still saved in the database and logged to the console.
RESEND_API_KEY=""
INQUIRY_TO_EMAIL="accueil@garagedelalargue.com"
INQUIRY_FROM_EMAIL="Garage de la Largue <noreply@garagedelalargue.fr>"

# Optional: DeepL for admin DE/EN translation of vehicle descriptions.
# Free keys typically end with :fx and use api-free.deepl.com.
DEEPL_API_KEY=""

# Optional fallbacks if not stored in Admin > Réglages
FACEBOOK_PAGE_ID=""
FACEBOOK_PAGE_ACCESS_TOKEN=""

# Seed staff passwords are set in prisma/seed.ts (change after first login).
